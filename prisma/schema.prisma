generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  passwordHash   String             @map("password_hash")
  firstName      String?            @map("first_name")
  lastName       String?            @map("last_name")
  phoneNumber    String?            @map("phone_number")
  city           String?            @map("city")
  country        String?            @map("country")
  additionalInfo String?          @map("additional_info")
  avatarUrl      String?            @map("avatar_url")
  language       String             @default("en")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")
  trips          Trip[]
  savedCities    SavedDestination[]

  @@map("users")
}

model City {
  id              String             @id @default(uuid())
  name            String
  country         String
  region          String?
  costIndex       Decimal?           @map("cost_index") @db.Decimal(5, 2)
  popularityScore Int                @default(0) @map("popularity_score")
  coverPhotoUrl   String?            @map("cover_photo_url")

  activities      Activity[]
  savedByUsers    SavedDestination[]
  stops           Stop[]

  @@map("cities")
}

model Trip {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  title         String
  description   String?
  coverPhotoUrl String?       @map("cover_photo_url")
  startDate     DateTime?     @map("start_date") @db.Date
  endDate       DateTime?     @map("end_date") @db.Date
  budgetLimit   Decimal?      @map("budget_limit") @db.Decimal(10, 2)
  shareToken    String?       @unique @map("share_token")
  isPublic      Boolean       @default(false) @map("is_public")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  budgetEntries BudgetEntry[]
  noteItems     Note[]
  packingItems  PackingItem[]
  stops         Stop[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trips")
}

model Stop {
  id             String         @id @default(uuid())
  tripId         String         @map("trip_id")
  cityId         String?        @map("city_id")
  sortOrder      Int            @map("sort_order")
  arriveDate     DateTime?      @map("arrive_date") @db.Date
  departDate     DateTime?      @map("depart_date") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at")
  cityName       String         @map("city_name")
  country        String?
  estimatedBudget Decimal?      @map("estimated_budget") @db.Decimal(10, 2)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  budgetEntries  BudgetEntry[]
  noteItems      Note[]
  stopActivities StopActivity[]
  city           City?          @relation(fields: [cityId], references: [id])
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, sortOrder])
  @@map("stops")
}

model Activity {
  id              String         @id @default(uuid())
  cityId          String         @map("city_id")
  name            String
  description     String?
  category        String?
  baseCost        Decimal?       @map("base_cost") @db.Decimal(8, 2)
  durationMinutes Int?           @map("duration_minutes")
  imageUrl        String?        @map("image_url")
  city            City           @relation(fields: [cityId], references: [id])
  stopActivities  StopActivity[]

  @@map("activities")
}

model StopActivity {
  id            String    @id @default(uuid())
  stopId        String    @map("stop_id")
  activityId    String    @map("activity_id")
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  scheduledTime DateTime? @map("scheduled_time") @db.Time(6)
  costOverride  Decimal?  @map("cost_override") @db.Decimal(8, 2)
  activity      Activity  @relation(fields: [activityId], references: [id])
  stop          Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([stopId, activityId])
  @@map("stop_activities")
}

model PackingItem {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  label     String
  category  String?
  isPacked  Boolean  @default(false) @map("is_packed")
  createdAt DateTime @default(now()) @map("created_at")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("packing_items")
}

model Note {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  stopId    String?  @map("stop_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  stop      Stop?    @relation(fields: [stopId], references: [id], onDelete: Cascade)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model BudgetEntry {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  stopId     String?  @map("stop_id")
  category   String
  label      String
  amount     Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  stop       Stop?    @relation(fields: [stopId], references: [id])
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("budget_entries")
}

model SavedDestination {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  cityId  String   @map("city_id")
  savedAt DateTime @default(now()) @map("saved_at")
  city    City     @relation(fields: [cityId], references: [id])
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@map("saved_destinations")
}
